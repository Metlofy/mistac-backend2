# ============================================================
# MistAC Backend — Ortam Degiskenleri
# ============================================================
# Bu dosyayi kopyalayip ".env" olarak kaydet.
# GIZLI BILGILER ICERIR — .gitignore'a ekle, paylaşma!
# ============================================================

# Discord Developer Portal'dan (https://discord.com/developers/applications):
DISCORD_CLIENT_ID=BURAYA_CLIENT_ID_YAZ
DISCORD_CLIENT_SECRET=BURAYA_CLIENT_SECRET_YAZ

# Backend URL'si (Railway/Render uzerinde deploy edince degistir)
# Ornek: https://mistac-backend.railway.app
BACKEND_URL=http://localhost:8787

# Discord'da redirect URI olarak sunu ekle:
#   http://localhost:8787/auth/callback

# Owner Discord ID
OWNER_DISCORD_ID=1097761624200314951

# Scanner EXE gizli anahtari (Program.cs ClientSecret ile ayni olmali)
CLIENT_SECRET=changeme-client-secret

PORT=8787
